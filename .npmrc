# Repo-level npm config.
#
# legacy-peer-deps=true
# ─────────────────────
# We have two transitive deps with conflicting peer requirements on
# esbuild that we can't fix at our level:
#
#   @opennextjs/aws  hard-pins  esbuild@0.25.4   (Cloudflare deploy path)
#   vite@8           peers      esbuild@^0.27.0 || ^0.28.0  (test path)
#
# Both are dev-only; runtime is unaffected. We need both, so we let npm
# resolve them by installing a single esbuild (0.25.4) and skipping the
# peer check. This makes `npm install` and `npm ci` agree on resolution
# so the Cloudflare build (which runs `npm ci` without flags) succeeds
# the same way local installs do.
#
# When @opennextjs/aws ships an esbuild bump, this can be removed.
legacy-peer-deps=true
